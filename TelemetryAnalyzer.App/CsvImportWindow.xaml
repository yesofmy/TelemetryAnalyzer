
<Window x:Class="TelemetryAnalyzer.App.CsvImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import Telemetry CSV"
        Width="1100"
        Height="760"
        MinWidth="800"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="#111318"
        Foreground="#E8EAED"
        FontFamily="Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#1A1E25"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#303641"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#FF9F43"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#9299A5"/>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#1A1E25"/>
            <Setter Property="Foreground" Value="#E8EAED"/>
            <Setter Property="BorderBrush" Value="#303641"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#303641"/>
            <Setter Property="VerticalGridLinesBrush" Value="#303641"/>
            <Setter Property="RowBackground" Value="#1A1E25"/>
            <Setter Property="AlternatingRowBackground" Value="#20252D"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="AutoGenerateColumns" Value="True"/>
            <Setter Property="ColumnHeaderHeight" Value="38"/>
            <Setter Property="RowHeight" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#242A33"/>
            <Setter Property="Foreground" Value="#FF9F43"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderBrush" Value="#303641"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#E8EAED"/>
            <Setter Property="Background" Value="#242A33"/>
            <Setter Property="BorderBrush" Value="#303641"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="IMPORT TELEMETRY"
                       FontSize="23"
                       FontWeight="SemiBold"
                       Foreground="#FFFFFF"/>

            <TextBlock Text="Load, validate and inspect a CSV data source"
                       FontSize="12"
                       Foreground="#9299A5"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <!-- Source file -->
        <Border Grid.Row="1"
                Background="#1A1E25"
                BorderBrush="#303641"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16"
                Margin="0,0,0,14">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="SOURCE FILE"
                               Foreground="#9299A5"
                               FontSize="10"
                               FontWeight="SemiBold"/>

                    <TextBlock x:Name="FilePathText"
                               Text="No file selected"
                               Foreground="#E8EAED"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,7,10,0"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="Browse &amp; Validate..."
                        VerticalAlignment="Center"
                        Click="Browse_Click"/>
            </Grid>
        </Border>

        <!-- Statistics -->
        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <Border Background="#1A1E25"
                    BorderBrush="#303641"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14"
                    Margin="0,0,10,0">

                <StackPanel>
                    <TextBlock Text="COLUMNS"
                               Foreground="#9299A5"
                               FontSize="10"/>

                    <TextBlock x:Name="ColumnCountText"
                               Text="0"
                               Foreground="#56B4E9"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Background="#1A1E25"
                    BorderBrush="#303641"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14"
                    Margin="0,0,10,0">

                <StackPanel>
                    <TextBlock Text="VALID RECORDS"
                               Foreground="#9299A5"
                               FontSize="10"/>

                    <TextBlock x:Name="RowCountText"
                               Text="0"
                               Foreground="#55D6A0"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Background="#1A1E25"
                    BorderBrush="#303641"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14">

                <StackPanel>
                    <TextBlock Text="IMPORT STATUS"
                               Foreground="#9299A5"
                               FontSize="10"/>

                    <TextBlock x:Name="StatusText"
                               Text="Waiting for a file"
                               Foreground="#FF9F43"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,7,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Validation information -->
        <Border Grid.Row="3"
                Background="#1A1E25"
                BorderBrush="#303641"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14"
                Margin="0,0,0,14">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Margin="0,0,14,0">

                    <TextBlock Text="DETECTED TELEMETRY CHANNELS"
                               Foreground="#9299A5"
                               FontSize="10"
                               FontWeight="SemiBold"/>

                    <TextBlock x:Name="DetectedChannelsText"
                               Text="No channels detected"
                               Foreground="#55D6A0"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1">

                    <TextBlock Text="VALIDATION WARNINGS"
                               Foreground="#9299A5"
                               FontSize="10"
                               FontWeight="SemiBold"/>

                    <TextBlock x:Name="WarningsText"
                               Text="No validation performed"
                               Foreground="#FF9F43"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Preview -->
        <Border Grid.Row="4"
                Background="#1A1E25"
                BorderBrush="#303641"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12">

            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="DATA PREVIEW"
                           Foreground="#FFFFFF"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Margin="4,2,0,12"/>

                <DataGrid x:Name="PreviewGrid"
                          AlternationCount="2"
                          IsReadOnly="True"
                          AutoGenerateColumns="True"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True"/>
            </DockPanel>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="5" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="MessageText"
                       Text="Select a CSV file to begin."
                       Foreground="#9299A5"
                       FontSize="11"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,0,15,0"/>

            <Button Grid.Column="1"
                    Content="Close"
                    MinWidth="90"
                    Margin="0"
                    Click="Close_Click"/>
        </Grid>
    </Grid>
</Window>
