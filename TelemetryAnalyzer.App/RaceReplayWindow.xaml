<Window x:Class="TelemetryAnalyzer.App.RaceReplayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Race Replay"
        Width="1400"
        Height="900"
        MinWidth="1000"
        MinHeight="700"
        WindowStartupLocation="CenterOwner"
        Background="#101318"
        Foreground="#F0F2F5">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="RACE REPLAY"
                           FontSize="26"
                           FontWeight="Bold"/>
                <TextBlock Text="Telemetry playback and track visualization"
                           Foreground="#9CA3AF"
                           Margin="0,5,0,0"/>
            </StackPanel>

            <TextBlock x:Name="TimeText"
                       Text="00:00.00"
                       FontSize="24"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"/>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#171B22"
                    BorderBrush="#303641"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="10"
                    Margin="0,0,14,0">
                <Grid>
                    <Canvas x:Name="TrackCanvas"
                            Background="#171B22"
                            SizeChanged="TrackCanvas_SizeChanged"/>

                    <Border HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="#252B35"
                            CornerRadius="6"
                            Padding="10,6">
                        <TextBlock Text="SPA-FRANCORCHAMPS"
                                   FontWeight="SemiBold"
                                   Foreground="#D1D5DB"/>
                    </Border>
                </Grid>
            </Border>

            <StackPanel Grid.Column="1">
                <TextBlock Text="LIVE TELEMETRY"
                           FontSize="16"
                           FontWeight="Bold"
                           Margin="0,0,0,12"/>

                <Border Background="#1B2029"
                        CornerRadius="10"
                        Padding="16"
                        Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="SPEED"
                                   Foreground="#9CA3AF"/>
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,5,0,0">
                            <TextBlock x:Name="SpeedText"
                                       Text="0"
                                       FontSize="38"
                                       FontWeight="Bold"/>
                            <TextBlock Text=" km/h"
                                       Foreground="#9CA3AF"
                                       VerticalAlignment="Bottom"
                                       Margin="6,0,0,7"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="#1B2029"
                        CornerRadius="10"
                        Padding="16"
                        Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="ENGINE RPM"
                                   Foreground="#9CA3AF"/>
                        <TextBlock x:Name="RpmText"
                                   Text="0"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="#1B2029"
                        CornerRadius="10"
                        Padding="16"
                        Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="GEAR"
                                   Foreground="#9CA3AF"/>
                        <TextBlock x:Name="GearText"
                                   Text="N"
                                   FontSize="34"
                                   FontWeight="Bold"
                                   Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="#1B2029"
                        CornerRadius="10"
                        Padding="16">
                    <StackPanel>
                        <TextBlock Text="THROTTLE"
                                   Foreground="#9CA3AF"/>
                        <ProgressBar x:Name="ThrottleBar"
                                     Minimum="0"
                                     Maximum="1"
                                     Value="0"
                                     Height="12"
                                     Margin="0,10,0,5"
                                     Foreground="#35C98A"/>
                        <TextBlock x:Name="ThrottleText"
                                   Text="0%"/>

                        <TextBlock Text="BRAKE"
                                   Foreground="#9CA3AF"
                                   Margin="0,16,0,0"/>
                        <ProgressBar x:Name="BrakeBar"
                                     Minimum="0"
                                     Maximum="1"
                                     Value="0"
                                     Height="12"
                                     Margin="0,10,0,5"
                                     Foreground="#EF5350"/>
                        <TextBlock x:Name="BrakeText"
                                   Text="0%"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,16,0,16">
            <Slider x:Name="TimelineSlider"
                    Minimum="0"
                    Maximum="1"
                    Value="0"
                    ValueChanged="TimelineSlider_ValueChanged"/>

            <DockPanel Margin="0,8,0,0">
                <TextBlock x:Name="ProgressText"
                           Text="Record 0 / 0"
                           Foreground="#9CA3AF"
                           VerticalAlignment="Center"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="Restart"
                            Click="Restart_Click"
                            Padding="14,8"
                            Margin="0,0,8,0"/>
                    <Button x:Name="PlayPauseButton"
                            Content="Play"
                            Click="PlayPause_Click"
                            Padding="22,8"
                            Margin="0,0,8,0"/>
                    <ComboBox x:Name="PlaybackSpeedCombo"
                              Width="100"
                              SelectedIndex="1"
                              SelectionChanged="PlaybackSpeedCombo_SelectionChanged">
                        <ComboBoxItem Content="0.5x"/>
                        <ComboBoxItem Content="1x"/>
                        <ComboBoxItem Content="2x"/>
                        <ComboBoxItem Content="4x"/>
                    </ComboBox>
                </StackPanel>
            </DockPanel>
        </StackPanel>

        <Border Grid.Row="3"
                Background="#171B22"
                BorderBrush="#303641"
                BorderThickness="1"
                CornerRadius="12"
                Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="TELEMETRY GRAPHS"
                           FontSize="15"
                           FontWeight="Bold"
                           Margin="0,0,0,10"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="4">
                        <TextBlock Text="Speed (km/h)"
                                   Foreground="#60A5FA"/>
                        <Canvas x:Name="SpeedGraph"
                                Height="110"
                                Background="#11151B"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="4">
                        <TextBlock Text="Throttle / Brake"
                                   Foreground="#34D399"/>
                        <Canvas x:Name="ControlsGraph"
                                Height="110"
                                Background="#11151B"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="4">
                        <TextBlock Text="RPM"
                                   Foreground="#FBBF24"/>
                        <Canvas x:Name="RpmGraph"
                                Height="110"
                                Background="#11151B"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
