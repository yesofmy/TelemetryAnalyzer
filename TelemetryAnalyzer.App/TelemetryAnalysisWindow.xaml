<Window x:Class="TelemetryAnalyzer.App.TelemetryAnalysisWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Telemetry Analysis"
        Width="1250"
        Height="900"
        MinWidth="900"
        MinHeight="650"
        WindowStartupLocation="CenterOwner"
        Background="#111318"
        Foreground="#F0F2F5">

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="TELEMETRY ANALYZER"
                           Foreground="#FF9F43"
                           FontSize="12"
                           FontWeight="Bold"/>

                <TextBlock x:Name="SessionNameText"
                           Text="Session"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Margin="0,5,0,0"/>

                <TextBlock x:Name="SessionDetailsText"
                           Text="Telemetry overview"
                           Foreground="#9299A5"
                           FontSize="12"
                           Margin="0,5,0,0"/>
            </StackPanel>

            <Border Grid.Column="1"
                    Background="#252A33"
                    CornerRadius="8"
                    Padding="14,10"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="DATA RECORDS"
                               Foreground="#9299A5"
                               FontSize="10"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="RecordCountText"
                               Text="0"
                               FontSize="21"
                               FontWeight="Bold"
                               Foreground="#FF9F43"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Statistics -->
        <UniformGrid Grid.Row="1"
                     Columns="3"
                     Margin="0,0,0,18">

            <Border Background="#1B2028"
                    BorderBrush="#303641"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14"
                    Margin="0,0,8,8">
                <StackPanel>
                    <TextBlock Text="MAX SPEED"
                               Foreground="#9299A5"
                               FontSize="10"/>
                    <TextBlock x:Name="MaxSpeedText"
                               Text="—"
                               FontSize="23"
                               FontWeight="Bold"
                               Foreground="#FF9F43"
                               Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="#1B2028"
                    BorderBrush="#303641"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14"
                    Margin="0,0,8,8">
                <StackPanel>
                    <TextBlock Text="AVERAGE SPEED"
                               Foreground="#9299A5"
                               FontSize="10"/>
                    <TextBlock x:Name="AverageSpeedText"
                               Text="—"
                               FontSize="23"
                               FontWeight="Bold"
                               Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="#1B2028"
                    BorderBrush="#303641"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14"
                    Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="MIN SPEED"
                               Foreground="#9299A5"
                               FontSize="10"/>
                    <TextBlock x:Name="MinSpeedText"
                               Text="—"
                               FontSize="23"
                               FontWeight="Bold"
                               Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="#1B2028"
                    BorderBrush="#303641"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14"
                    Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="RECORD DURATION"
                               Foreground="#9299A5"
                               FontSize="10"/>
                    <TextBlock x:Name="DurationText"
                               Text="—"
                               FontSize="20"
                               FontWeight="Bold"
                               Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="#1B2028"
                    BorderBrush="#303641"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14"
                    Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="MAX RPM"
                               Foreground="#9299A5"
                               FontSize="10"/>
                    <TextBlock x:Name="MaxRpmText"
                               Text="—"
                               FontSize="20"
                               FontWeight="Bold"
                               Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="#1B2028"
                    BorderBrush="#303641"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14">
                <StackPanel>
                    <TextBlock Text="DISTANCE RANGE"
                               Foreground="#9299A5"
                               FontSize="10"/>
                    <TextBlock x:Name="DistanceText"
                               Text="—"
                               FontSize="20"
                               FontWeight="Bold"
                               Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Charts -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel>

                <Border Background="#1B2028"
                        BorderBrush="#303641"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="SPEED"
                                   Foreground="#FF9F43"
                                   FontSize="13"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Speed values from the imported file"
                                   Foreground="#9299A5"
                                   FontSize="11"
                                   Margin="0,4,0,8"/>

                        <Canvas x:Name="SpeedCanvas"
                                Height="180"
                                Background="#171B22"
                                ClipToBounds="True"
                                SizeChanged="ChartCanvas_SizeChanged"/>
                    </StackPanel>
                </Border>

                <Border Background="#1B2028"
                        BorderBrush="#303641"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="THROTTLE"
                                   Foreground="#5BC0BE"
                                   FontSize="13"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Accelerator input"
                                   Foreground="#9299A5"
                                   FontSize="11"
                                   Margin="0,4,0,8"/>

                        <Canvas x:Name="ThrottleCanvas"
                                Height="150"
                                Background="#171B22"
                                ClipToBounds="True"
                                SizeChanged="ChartCanvas_SizeChanged"/>
                    </StackPanel>
                </Border>

                <Border Background="#1B2028"
                        BorderBrush="#303641"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="BRAKE"
                                   Foreground="#EF6461"
                                   FontSize="13"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Brake input"
                                   Foreground="#9299A5"
                                   FontSize="11"
                                   Margin="0,4,0,8"/>

                        <Canvas x:Name="BrakeCanvas"
                                Height="150"
                                Background="#171B22"
                                ClipToBounds="True"
                                SizeChanged="ChartCanvas_SizeChanged"/>
                    </StackPanel>
                </Border>

                <Border Background="#1B2028"
                        BorderBrush="#303641"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="ENGINE RPM"
                                   Foreground="#A78BFA"
                                   FontSize="13"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Engine revolutions per minute"
                                   Foreground="#9299A5"
                                   FontSize="11"
                                   Margin="0,4,0,8"/>

                        <Canvas x:Name="RpmCanvas"
                                Height="150"
                                Background="#171B22"
                                ClipToBounds="True"
                                SizeChanged="ChartCanvas_SizeChanged"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
