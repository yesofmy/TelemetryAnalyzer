<Window x:Class="TelemetryAnalyzer.App.TelemetryPlotTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        Title="Telemetry Studio"
        Width="1100"
        Height="720"
        MinWidth="800"
        MinHeight="550"
        Background="#111318"
        Foreground="#F0F2F5">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="TELEMETRY STUDIO"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#FF9F43"/>

            <TextBlock Text="Explore speed data from imported telemetry sessions"
                       FontSize="13"
                       Foreground="#9299A5"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="#1A1E25"
                BorderBrush="#303641"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14"
                Margin="0,0,0,16">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                            Text="Session:"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0"
                            Foreground="#9299A5"/>

                    <ComboBox x:Name="SessionComboBox"
                            Grid.Column="1"
                            Height="34"
                            VerticalContentAlignment="Center"
                            DisplayMemberPath="Name"
                            SelectionChanged="SessionComboBox_SelectionChanged"/>

                    <TextBlock Grid.Column="2"
                            Text="Channel:"
                            VerticalAlignment="Center"
                            Margin="16,0,12,0"
                            Foreground="#9299A5"/>

                    <ComboBox x:Name="ChannelComboBox"
                            Grid.Column="3"
                            Height="34"
                            Margin="0,0,12,0"
                            VerticalContentAlignment="Center"
                            SelectionChanged="ChannelComboBox_SelectionChanged"/>

                    <Button Grid.Column="4"
                            Content="Refresh"
                            Click="Refresh_Click"
                            Padding="18,5"
                            Background="#FF9F43"
                            Foreground="#111318"
                            FontWeight="SemiBold"
                            BorderThickness="0"/>
                </Grid>
        </Border>

        <Border Grid.Row="2"
                Background="#1A1E25"
                BorderBrush="#303641"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12">

            <ScottPlot:WpfPlot x:Name="TelemetryPlot"/>
        </Border>

        <TextBlock x:Name="StatusText"
                   Grid.Row="3"
                   Text="Loading telemetry sessions..."
                   Foreground="#9299A5"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Margin="2,12,2,0"/>
    </Grid>
</Window>
