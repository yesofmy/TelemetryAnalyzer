
<Window x:Class="TelemetryAnalyzer.App.TrackVisualizationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Track Visualization - Spa-Francorchamps"
        Width="1200"
        Height="800"
        MinWidth="850"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="#111318"
        Foreground="#F0F2F5">

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="TRACK VISUALIZATION"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#FF9F43"/>

                <TextBlock Text="Circuit layout and track boundaries"
                           FontSize="13"
                           Foreground="#9299A5"
                           Margin="0,6,0,0"/>
            </StackPanel>

            <Border Grid.Column="1"
                    Background="#252A33"
                    CornerRadius="8"
                    Padding="12,8"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="CIRCUIT"
                               FontSize="10"
                               Foreground="#9299A5"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="SPA-FRANCORCHAMPS"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="#FF9F43"/>
                </StackPanel>
            </Border>
        </Grid>

        <UniformGrid Grid.Row="1"
                     Columns="4"
                     Margin="0,0,0,16">

            <Border Background="#1A1E25"
                    BorderBrush="#303641"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="LOCATION"
                               Foreground="#9299A5"
                               FontSize="10"/>
                    <TextBlock Text="Belgium"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="#1A1E25"
                    BorderBrush="#303641"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="LAP LENGTH"
                               Foreground="#9299A5"
                               FontSize="10"/>
                    <TextBlock Text="7.004 km"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="#1A1E25"
                    BorderBrush="#303641"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="TRACK POINTS"
                               Foreground="#9299A5"
                               FontSize="10"/>
                    <TextBlock x:Name="TrackPointsValue"
                               Text="Loading..."
                               FontSize="17"
                               FontWeight="SemiBold"
                               Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="#1A1E25"
                    BorderBrush="#303641"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12">
                <StackPanel>
                    <TextBlock Text="DATA SOURCE"
                               Foreground="#9299A5"
                               FontSize="10"/>
                    <TextBlock Text="spa.csv"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="2"
                Background="#171B22"
                BorderBrush="#303641"
                BorderThickness="1"
                CornerRadius="12"
                Padding="10"
                ClipToBounds="True">

            <Canvas x:Name="TrackCanvas"
                    Background="#171B22"
                    ClipToBounds="True"
                    SizeChanged="TrackCanvas_SizeChanged"/>
        </Border>

        <Grid Grid.Row="3" Margin="2,14,2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <WrapPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal"
                            Margin="0,0,18,0">
                    <Rectangle Width="18"
                               Height="4"
                               Fill="#FF9F43"
                               VerticalAlignment="Center"/>
                    <TextBlock Text=" Center line"
                               Foreground="#9299A5"
                               FontSize="11"
                               Margin="6,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            Margin="0,0,18,0">
                    <Rectangle Width="18"
                               Height="4"
                               Fill="#F0F2F5"
                               VerticalAlignment="Center"/>
                    <TextBlock Text=" Track boundaries"
                               Foreground="#9299A5"
                               FontSize="11"
                               Margin="6,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Rectangle Width="18"
                               Height="10"
                               Fill="#414952"
                               VerticalAlignment="Center"/>
                    <TextBlock Text=" Track surface"
                               Foreground="#9299A5"
                               FontSize="11"
                               Margin="6,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </WrapPanel>

            <TextBlock Grid.Column="1"
                       Text="CSV geometry · No telemetry loaded"
                       Foreground="#9299A5"
                       FontSize="11"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"/>
        </Grid>
    </Grid>
</Window>
