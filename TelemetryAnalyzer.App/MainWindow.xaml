
<Window x:Class="TelemetryAnalyzer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Telemetry Analyzer"
        Width="1440"
        Height="900"
        MinWidth="1050"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="#111318"
        Foreground="#E8EAED"
        FontFamily="Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="BackgroundBrush" Color="#111318"/>
        <SolidColorBrush x:Key="SidebarBrush" Color="#171A20"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#1A1E25"/>
        <SolidColorBrush x:Key="PanelLightBrush" Color="#242A33"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#FF9F43"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#9299A5"/>
        <SolidColorBrush x:Key="LineBrush" Color="#303641"/>

        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#AEB5C0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="16,13"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder"
                                        Property="Background"
                                        Value="#242A33"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="NavBorder"
                                        Property="Background"
                                        Value="#343B46"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="#111318"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="17,11"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#FFB66D"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#E88A30"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="MutedTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9299A5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="245"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0"
                Background="{StaticResource SidebarBrush}"
                BorderBrush="#2B3039"
                BorderThickness="0,0,1,0">

            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top"
                            Margin="22,26,22,30">
                    <Border Width="48"
                            Height="48"
                            CornerRadius="12"
                            Background="#30271F"
                            HorizontalAlignment="Left">
                        <TextBlock Text="TA"
                                   Foreground="#FF9F43"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="TELEMETRY ANALYZER"
                               Foreground="#FFFFFF"
                               FontSize="12"
                               FontWeight="Bold"
                               Margin="0,14,0,0"/>

                    <TextBlock Text="MOTORSPORT DATA SYSTEM"
                               Foreground="#747D8A"
                               FontSize="9"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom"
                            Margin="20,15,20,22">
                    <Border Height="1"
                            Background="#303641"
                            Margin="0,0,0,15"/>

                    <TextBlock Text="APPLICATION"
                               Foreground="#747D8A"
                               FontSize="10"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="Version 0.1.0"
                               Foreground="#AEB5C0"
                               FontSize="11"
                               Margin="0,7,0,0"/>

                    <TextBlock Text=".NET 10 · WPF"
                               Foreground="#747D8A"
                               FontSize="10"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12,0,12,0">
                        <TextBlock Text="WORKSPACE"
                                   Foreground="#747D8A"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Margin="12,0,0,10"/>

                        <Button x:Name="NavDashboard"
                                Content="▦    Dashboard"
                                Style="{StaticResource NavButtonStyle}"
                                Click="Dashboard_Click"/>

                        <Button x:Name="NavSessions"
                                Content="◷    Sessions &amp; Import"
                                Style="{StaticResource NavButtonStyle}"
                                Click="Sessions_Click"/>

                        <Button x:Name="NavTelemetry"
                                Content="⌁    Telemetry Studio"
                                Style="{StaticResource NavButtonStyle}"
                                Click="Telemetry_Click"/>

                        <Button x:Name="NavAnalysis"
                                Content="∿    Signal Analysis"
                                Style="{StaticResource NavButtonStyle}"
                                Click="Analysis_Click"/>

                        <TextBlock Text="REFERENCE DATA"
                                   Foreground="#747D8A"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Margin="12,28,0,10"/>

                        <Button x:Name="NavTracks"
                                Content="◎    Tracks"
                                Style="{StaticResource NavButtonStyle}"
                                Click="Tracks_Click"/>

                        <Button x:Name="NavSettings"
                                Content="⚙    Settings"
                                Style="{StaticResource NavButtonStyle}"
                                Click="Settings_Click"/>
                        <Button Content="Race Replay"
                                Click="RaceReplay_Click"
                                Margin="8"
                                Padding="12,10"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- MAIN AREA -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="76"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TOP BAR -->
            <Border Grid.Row="0"
                    Background="#171A20"
                    BorderBrush="#2B3039"
                    BorderThickness="0,0,0,1">
                <Grid Margin="30,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitle"
                                   Text="Dashboard"
                                   Foreground="#FFFFFF"
                                   FontSize="20"
                                   FontWeight="SemiBold"/>

                        <TextBlock x:Name="PageSubtitle"
                                   Text="Overview of your telemetry workspace"
                                   Foreground="#9299A5"
                                   FontSize="11"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Background="#242A33"
                            CornerRadius="7"
                            Padding="12,8"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7"
                                     Height="7"
                                     Fill="#55D6A0"
                                     VerticalAlignment="Center"
                                     Margin="0,0,8,0"/>

                            <TextBlock Text="LOCAL WORKSPACE"
                                       Foreground="#C7CDD6"
                                       FontSize="10"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- PAGE CONTENT -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <StackPanel x:Name="MainContent"
                            Margin="30,28,30,30">

                    <!-- WELCOME -->
                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Welcome to Telemetry Analyzer"
                                       FontSize="25"
                                       FontWeight="SemiBold"
                                       Foreground="#FFFFFF"
                                       TextWrapping="Wrap"/>

                            <TextBlock Text="Import, inspect and analyze motorsport telemetry."
                                       FontSize="13"
                                       Foreground="#9299A5"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Content="+  Import CSV"
                                Style="{StaticResource PrimaryButtonStyle}"
                                VerticalAlignment="Center"
                                Margin="16,0,0,0"
                                Click="ImportCsv_Click"/>
                    </Grid>

                    <!-- STATISTICS -->
                    <UniformGrid Columns="4" Margin="0,0,0,22">
                        <Border Style="{StaticResource PanelStyle}"
                                Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="TOTAL SESSIONS"
                                           Foreground="#9299A5"
                                           FontSize="10"
                                           FontWeight="SemiBold"/>

                                <TextBlock x:Name="SessionsValue"
                                           Text="0"
                                           Foreground="#FFFFFF"
                                           FontSize="30"
                                           FontWeight="SemiBold"
                                           Margin="0,12,0,4"/>

                                <TextBlock Text="Imported sessions"
                                           Foreground="#747D8A"
                                           FontSize="11"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource PanelStyle}"
                                Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="DATA POINTS"
                                           Foreground="#9299A5"
                                           FontSize="10"
                                           FontWeight="SemiBold"/>

                                <TextBlock x:Name="DataPointsValue"
                                           Text="0"
                                           Foreground="#56B4E9"
                                           FontSize="30"
                                           FontWeight="SemiBold"
                                           Margin="0,12,0,4"/>

                                <TextBlock Text="Telemetry records"
                                           Foreground="#747D8A"
                                           FontSize="11"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource PanelStyle}"
                                Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="TRACK DATA"
                                           Foreground="#9299A5"
                                           FontSize="10"
                                           FontWeight="SemiBold"/>

                                <TextBlock x:Name="TracksValue"
                                           Text="—"
                                           Foreground="#55D6A0"
                                           FontSize="30"
                                           FontWeight="SemiBold"
                                           Margin="0,12,0,4"/>

                                <TextBlock Text="Reference module"
                                           Foreground="#747D8A"
                                           FontSize="11"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource PanelStyle}">
                            <StackPanel>
                                <TextBlock Text="FILTER ALGORITHMS"
                                           Foreground="#9299A5"
                                           FontSize="10"
                                           FontWeight="SemiBold"/>

                                <TextBlock Text="2"
                                           Foreground="#FF9F43"
                                           FontSize="30"
                                           FontWeight="SemiBold"
                                           Margin="0,12,0,4"/>

                                <TextBlock Text="Naive and optimized"
                                           Foreground="#747D8A"
                                           FontSize="11"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- LOWER CONTENT -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.4*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <!-- RECENT SESSIONS -->
                        <Border Grid.Column="0"
                                Style="{StaticResource PanelStyle}"
                                Margin="0,0,12,0"
                                MinHeight="310">

                            <StackPanel>
                                <TextBlock Text="RECENT SESSIONS"
                                           Style="{StaticResource SectionTitleStyle}"/>

                                <TextBlock Text="Double-click a session to analyze telemetry."
                                           Style="{StaticResource MutedTextStyle}"
                                           Margin="0,7,0,18"/>

                                <Border Background="#20252D"
                                        CornerRadius="9"
                                        Padding="10"
                                        MinHeight="175">

                                    <Grid>
                                        <ListBox x:Name="RecentSessionsList"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Foreground="#E8EAED"
                                                 MaxHeight="270"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 MouseDoubleClick="RecentSessionsList_MouseDoubleClick">

                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Padding" Value="0"/>
                                                    <Setter Property="Margin" Value="0,0,0,6"/>
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <Border x:Name="ItemBorder"
                                                                        Background="#292F39"
                                                                        CornerRadius="7"
                                                                        Padding="12">
                                                                    <ContentPresenter/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="ItemBorder"
                                                                                Property="Background"
                                                                                Value="#343B46"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsSelected" Value="True">
                                                                        <Setter TargetName="ItemBorder"
                                                                                Property="Background"
                                                                                Value="#3A3026"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>

                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}"
                                                                       Foreground="#FFFFFF"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis"/>

                                                            <TextBlock Text="{Binding ImportedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                                                       Foreground="#9299A5"
                                                                       FontSize="10"
                                                                       Margin="0,5,0,0"/>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="1"
                                                                    VerticalAlignment="Center"
                                                                    Margin="12,0,0,0">
                                                            <TextBlock Text="{Binding RecordCount}"
                                                                       Foreground="#56B4E9"
                                                                       FontSize="15"
                                                                       FontWeight="SemiBold"
                                                                       HorizontalAlignment="Right"/>

                                                            <TextBlock Text="records"
                                                                       Foreground="#9299A5"
                                                                       FontSize="10"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <StackPanel x:Name="EmptySessionsPanel"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Center"
                                                    IsHitTestVisible="False">
                                            <TextBlock Text="◷"
                                                       Foreground="#FF9F43"
                                                       FontSize="32"
                                                       HorizontalAlignment="Center"/>

                                            <TextBlock Text="No sessions yet"
                                                       Foreground="#FFFFFF"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,8,0,5"/>

                                            <TextBlock Text="Import a CSV file to get started."
                                                       Foreground="#9299A5"
                                                       FontSize="11"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Button Content="Open all sessions  →"
                                        HorizontalAlignment="Left"
                                        Margin="0,15,0,0"
                                        Style="{StaticResource NavButtonStyle}"
                                        Click="Sessions_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- RIGHT COLUMN -->
                        <StackPanel Grid.Column="1">
                            <Border Style="{StaticResource PanelStyle}"
                                    Margin="0,0,0,14">

                                <StackPanel>
                                    <TextBlock Text="QUICK ACTIONS"
                                               Style="{StaticResource SectionTitleStyle}"
                                               Margin="0,0,0,12"/>

                                    <Button Content="+    Import telemetry CSV"
                                            Style="{StaticResource NavButtonStyle}"
                                            Click="ImportCsv_Click"/>

                                    <Button Content="⌁    Open Telemetry Studio"
                                            Style="{StaticResource NavButtonStyle}"
                                            Click="Telemetry_Click"/>

                                    <Button Content="∿    Open Signal Analysis"
                                            Style="{StaticResource NavButtonStyle}"
                                            Click="Analysis_Click"/>

                                    <Button Content="◷    Browse sessions"
                                            Style="{StaticResource NavButtonStyle}"
                                            Click="Sessions_Click"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource PanelStyle}">
                                <StackPanel>
                                    <TextBlock Text="SYSTEM STATUS"
                                               Style="{StaticResource SectionTitleStyle}"
                                               Margin="0,0,0,14"/>

                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="Application"
                                                   Foreground="#AEB5C0"
                                                   FontSize="12"/>

                                        <TextBlock Grid.Column="1"
                                                   Text="Ready"
                                                   Foreground="#55D6A0"
                                                   FontSize="12"/>
                                    </Grid>

                                    <Grid Margin="0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="Database"
                                                   Foreground="#AEB5C0"
                                                   FontSize="12"/>

                                        <TextBlock x:Name="DatabaseStatusText"
                                                   Grid.Column="1"
                                                   Text="Checking..."
                                                   Foreground="#FF9F43"
                                                   FontSize="12"/>
                                    </Grid>

                                    <Grid Margin="0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="Telemetry"
                                                   Foreground="#AEB5C0"
                                                   FontSize="12"/>

                                        <TextBlock x:Name="TelemetryStatusText"
                                                   Grid.Column="1"
                                                   Text="Not imported"
                                                   Foreground="#FF9F43"
                                                   FontSize="12"/>
                                    </Grid>

                                    <Border Height="1"
                                            Background="#303641"
                                            Margin="0,15,0,12"/>

                                    <TextBlock Text="Local data storage"
                                               Foreground="#FFFFFF"
                                               FontSize="12"
                                               FontWeight="SemiBold"/>

                                    <TextBlock Text="Your imported sessions are stored in the local application database."
                                               Foreground="#9299A5"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="TELEMETRY ANALYZER  /  ENGINEERING WORKSPACE"
                               Foreground="#59616D"
                               FontSize="9"
                               Margin="0,24,0,0"
                               HorizontalAlignment="Right"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
