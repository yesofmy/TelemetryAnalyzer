
<Window x:Class="TelemetryAnalyzer.App.SignalAnalysisWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        Title="Signal Analysis"
        Width="1150"
        Height="760"
        MinWidth="850"
        MinHeight="600"
        Background="#111318"
        Foreground="#F0F2F5">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="SIGNAL ANALYSIS"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#FF9F43"/>

            <TextBlock Text="Moving Average filter and signal comparison"
                       FontSize="13"
                       Foreground="#9299A5"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <!-- Analysis controls -->
        <Border Grid.Row="1"
                Background="#1A1E25"
                BorderBrush="#303641"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14"
                Margin="0,0,0,16">

            <WrapPanel VerticalAlignment="Center">

                <!-- Session -->
                <StackPanel Width="190"
                            Margin="0,0,14,8">
                    <TextBlock Text="Session"
                               Foreground="#9299A5"
                               Margin="0,0,0,6"/>

                    <ComboBox x:Name="SessionComboBox"
                              Height="34"
                              DisplayMemberPath="Name"
                              SelectionChanged="Selection_Changed"/>
                </StackPanel>

                <!-- Channel -->
                <StackPanel Width="130"
                            Margin="0,0,14,8">
                    <TextBlock Text="Channel"
                               Foreground="#9299A5"
                               Margin="0,0,0,6"/>

                    <ComboBox x:Name="ChannelComboBox"
                              Height="34"
                              SelectionChanged="Selection_Changed"/>
                </StackPanel>

                <!-- Window size -->
                <StackPanel Width="120"
                            Margin="0,0,14,8">
                    <TextBlock Text="Window size"
                               Foreground="#9299A5"
                               Margin="0,0,0,6"/>

                    <TextBox x:Name="WindowSizeTextBox"
                             Text="5"
                             Height="34"
                             Padding="8,5"
                             VerticalContentAlignment="Center"/>
                </StackPanel>

                <!-- Algorithm -->
                <StackPanel Width="240"
                            Margin="0,0,14,8">
                    <TextBlock Text="Filtering Algorithm"
                               Foreground="#9299A5"
                               Margin="0,0,0,6"/>

                    <ComboBox x:Name="AlgorithmComboBox"
                              Height="34"
                              HorizontalAlignment="Stretch"
                              SelectionChanged="Selection_Changed"/>
                </StackPanel>

                <!-- Apply filter button -->
                <StackPanel VerticalAlignment="Bottom"
                            Margin="0,0,0,8">

                    <Button Content="▶  Apply filter"
                            Click="ApplyFilter_Click"
                            Height="36"
                            MinWidth="145"
                            Padding="18,5"
                            Background="#FF9F43"
                            Foreground="#111318"
                            FontWeight="Bold"
                            FontSize="13"
                            BorderThickness="0"
                            Cursor="Hand"/>
                </StackPanel>

            </WrapPanel>
        </Border>

        <!-- Signal plot -->
        <Border Grid.Row="2"
                Background="#1A1E25"
                BorderBrush="#303641"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12">

            <ScottPlot:WpfPlot x:Name="AnalysisPlot"/>
        </Border>

        <!-- Status -->
        <TextBlock x:Name="StatusText"
                   Grid.Row="3"
                   Text="Select a session and channel."
                   Foreground="#9299A5"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Margin="2,12,2,0"/>

    </Grid>
</Window>
