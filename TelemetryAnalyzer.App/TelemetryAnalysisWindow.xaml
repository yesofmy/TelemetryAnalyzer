<Window x:Class="TelemetryAnalyzer.App.TelemetryAnalysisWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Telemetry Analysis"
        Width="1350"
        Height="950"
        MinWidth="1000"
        MinHeight="700"
        WindowStartupLocation="CenterOwner"
        Background="#111318"
        Foreground="#F0F2F5">

    <Window.Resources>
        <Style x:Key="ExportButton" TargetType="Button">
            <Setter Property="Background" Value="#252A33"/>
            <Setter Property="Foreground" Value="#F0F2F5"/>
            <Setter Property="BorderBrush" Value="#3A414D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,8"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#343C48"/>
                                <Setter Property="BorderBrush" Value="#FF9F43"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#414B59"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="#1B2028"/>
            <Setter Property="BorderBrush" Value="#303641"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="13"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#171B22"/>
            <Setter Property="Foreground" Value="#F0F2F5"/>
            <Setter Property="BorderBrush" Value="#303641"/>
            <Setter Property="RowBackground" Value="#1B2028"/>
            <Setter Property="AlternatingRowBackground" Value="#202630"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#303641"/>
            <Setter Property="VerticalGridLinesBrush" Value="#303641"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="ColumnHeaderHeight" Value="36"/>
            <Setter Property="RowHeight" Value="34"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#252A33"/>
            <Setter Property="Foreground" Value="#B7BEC9"/>
            <Setter Property="BorderBrush" Value="#303641"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="TELEMETRY ANALYZER"
                           Foreground="#FF9F43"
                           FontSize="12"
                           FontWeight="Bold"/>

                <TextBlock x:Name="SessionNameText"
                           Text="Session"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Margin="0,5,0,0"/>

                <TextBlock x:Name="SessionDetailsText"
                           Text="Telemetry overview"
                           Foreground="#9299A5"
                           FontSize="12"
                           Margin="0,5,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button Content="EXPORT CSV"
                        Style="{StaticResource ExportButton}"
                        Click="ExportCsv_Click"/>

                <Button Content="EXPORT JSON"
                        Style="{StaticResource ExportButton}"
                        Click="ExportJson_Click"/>

                <Button Content="HTML REPORT"
                        Style="{StaticResource ExportButton}"
                        Click="ExportHtml_Click"/>

                <Border Background="#252A33"
                        CornerRadius="8"
                        Padding="14,10"
                        Margin="12,0,0,0">
                    <StackPanel>
                        <TextBlock Text="DATA RECORDS"
                                   Foreground="#9299A5"
                                   FontSize="10"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="RecordCountText"
                                   Text="0"
                                   FontSize="21"
                                   FontWeight="Bold"
                                   Foreground="#FF9F43"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Statistics -->
        <UniformGrid Grid.Row="1"
                     Columns="4"
                     Margin="0,0,0,12">

            <Border Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="MAX SPEED" Foreground="#9299A5" FontSize="10"/>
                    <TextBlock x:Name="MaxSpeedText" Text="—" FontSize="21"
                               FontWeight="Bold" Foreground="#FF9F43" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="AVERAGE SPEED" Foreground="#9299A5" FontSize="10"/>
                    <TextBlock x:Name="AverageSpeedText" Text="—" FontSize="21"
                               FontWeight="Bold" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="MIN SPEED" Foreground="#9299A5" FontSize="10"/>
                    <TextBlock x:Name="MinSpeedText" Text="—" FontSize="21"
                               FontWeight="Bold" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="RECORD DURATION" Foreground="#9299A5" FontSize="10"/>
                    <TextBlock x:Name="DurationText" Text="—" FontSize="20"
                               FontWeight="Bold" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="MAX RPM" Foreground="#9299A5" FontSize="10"/>
                    <TextBlock x:Name="MaxRpmText" Text="—" FontSize="20"
                               FontWeight="Bold" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="AVERAGE RPM" Foreground="#9299A5" FontSize="10"/>
                    <TextBlock x:Name="AverageRpmText" Text="—" FontSize="20"
                               FontWeight="Bold" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="DISTANCE RANGE" Foreground="#9299A5" FontSize="10"/>
                    <TextBlock x:Name="DistanceText" Text="—" FontSize="20"
                               FontWeight="Bold" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="GEARS USED" Foreground="#9299A5" FontSize="10"/>
                    <TextBlock x:Name="GearsText" Text="—" FontSize="20"
                               FontWeight="Bold" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="AVERAGE THROTTLE" Foreground="#9299A5" FontSize="10"/>
                    <TextBlock x:Name="AverageThrottleText" Text="—" FontSize="20"
                               FontWeight="Bold" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="AVERAGE BRAKE" Foreground="#9299A5" FontSize="10"/>
                    <TextBlock x:Name="AverageBrakeText" Text="—" FontSize="20"
                               FontWeight="Bold" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="POTENTIAL ANOMALIES" Foreground="#9299A5" FontSize="10"/>
                    <TextBlock x:Name="AnomalyCountText" Text="0" FontSize="20"
                               FontWeight="Bold" Foreground="#EF6461" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="ANALYZED CHANNELS" Foreground="#9299A5" FontSize="10"/>
                    <TextBlock x:Name="ChannelCountText" Text="0" FontSize="20"
                               FontWeight="Bold" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Analysis content -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel>

                <!-- Anomaly analysis -->
                <Border Background="#1B2028"
                        BorderBrush="#303641"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="15"
                        Margin="0,0,0,12">

                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="ANOMALY DETECTION"
                                           Foreground="#FF9F43"
                                           FontSize="13"
                                           FontWeight="Bold"/>
                                <TextBlock Text="Potentially unusual changes between consecutive telemetry records"
                                           Foreground="#9299A5"
                                           FontSize="11"
                                           Margin="0,4,0,0"/>
                            </StackPanel>

                            <TextBlock x:Name="AnomalyStatusText"
                                       Grid.Column="1"
                                       Text="Analysis complete"
                                       Foreground="#9299A5"
                                       FontSize="11"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <DataGrid x:Name="AnomaliesGrid"
                                  Height="210"
                                  ItemsSource="{Binding}"
                                  AlternationCount="2">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="RECORD"
                                                    Binding="{Binding RecordIndex}"
                                                    Width="90"/>
                                <DataGridTextColumn Header="CHANNEL"
                                                    Binding="{Binding Channel}"
                                                    Width="150"/>
                                <DataGridTextColumn Header="VALUE"
                                                    Binding="{Binding Value}"
                                                    Width="120"/>
                                <DataGridTextColumn Header="CHANGE"
                                                    Binding="{Binding Change}"
                                                    Width="120"/>
                                <DataGridTextColumn Header="DESCRIPTION"
                                                    Binding="{Binding Description}"
                                                    Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- Speed -->
                <Border Background="#1B2028" BorderBrush="#303641"
                        BorderThickness="1" CornerRadius="10"
                        Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="SPEED" Foreground="#FF9F43"
                                   FontSize="13" FontWeight="Bold"/>
                        <TextBlock Text="Speed values from the imported file"
                                   Foreground="#9299A5" FontSize="11"
                                   Margin="0,4,0,8"/>
                        <Canvas x:Name="SpeedCanvas" Height="180"
                                Background="#171B22" ClipToBounds="True"
                                SizeChanged="ChartCanvas_SizeChanged"/>
                    </StackPanel>
                </Border>

                <!-- Throttle -->
                <Border Background="#1B2028" BorderBrush="#303641"
                        BorderThickness="1" CornerRadius="10"
                        Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="THROTTLE" Foreground="#5BC0BE"
                                   FontSize="13" FontWeight="Bold"/>
                        <TextBlock Text="Accelerator input"
                                   Foreground="#9299A5" FontSize="11"
                                   Margin="0,4,0,8"/>
                        <Canvas x:Name="ThrottleCanvas" Height="150"
                                Background="#171B22" ClipToBounds="True"
                                SizeChanged="ChartCanvas_SizeChanged"/>
                    </StackPanel>
                </Border>

                <!-- Brake -->
                <Border Background="#1B2028" BorderBrush="#303641"
                        BorderThickness="1" CornerRadius="10"
                        Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="BRAKE" Foreground="#EF6461"
                                   FontSize="13" FontWeight="Bold"/>
                        <TextBlock Text="Brake input"
                                   Foreground="#9299A5" FontSize="11"
                                   Margin="0,4,0,8"/>
                        <Canvas x:Name="BrakeCanvas" Height="150"
                                Background="#171B22" ClipToBounds="True"
                                SizeChanged="ChartCanvas_SizeChanged"/>
                    </StackPanel>
                </Border>

                <!-- RPM -->
                <Border Background="#1B2028" BorderBrush="#303641"
                        BorderThickness="1" CornerRadius="10"
                        Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="ENGINE RPM" Foreground="#A78BFA"
                                   FontSize="13" FontWeight="Bold"/>
                        <TextBlock Text="Engine revolutions per minute"
                                   Foreground="#9299A5" FontSize="11"
                                   Margin="0,4,0,8"/>
                        <Canvas x:Name="RpmCanvas" Height="150"
                                Background="#171B22" ClipToBounds="True"
                                SizeChanged="ChartCanvas_SizeChanged"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>