
<Window x:Class="TelemetryAnalyzer.App.TelemetryPlotTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        Title="Telemetry Studio"
        Width="1440"
        Height="950"
        MinWidth="1050"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="#111318"
        Foreground="#F0F2F5">

    <Window.Resources>

        <!-- ComboBox Item -->
        <Style x:Key="DarkComboBoxItemStyle"
               TargetType="ComboBoxItem">

            <Setter Property="Background" Value="#242A33"/>
            <Setter Property="Foreground" Value="#F0F2F5"/>
            <Setter Property="Padding" Value="10,9"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>

            <Style.Triggers>

                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#343B46"/>
                    <Setter Property="Foreground" Value="#FF9F43"/>
                </Trigger>

                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#343B46"/>
                    <Setter Property="Foreground" Value="#FF9F43"/>
                </Trigger>

                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#626B78"/>
                </Trigger>

            </Style.Triggers>
        </Style>

        <!-- Dark ComboBox -->
        <Style TargetType="ComboBox">

            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="#242A33"/>
            <Setter Property="Foreground" Value="#F0F2F5"/>
            <Setter Property="BorderBrush" Value="#343B46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ItemContainerStyle"
                    Value="{StaticResource DarkComboBoxItemStyle}"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="ComboBox">

                        <Grid>

                            <Border x:Name="ComboBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="5"/>

                            <!-- Selected item and arrow -->
                            <Grid IsHitTestVisible="False">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="32"/>
                                </Grid.ColumnDefinitions>

                                <ContentPresenter Grid.Column="0"
                                                  Margin="10,0,0,0"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>

                                <TextBlock Grid.Column="1"
                                           Text="⌄"
                                           FontSize="15"
                                           Foreground="#9299A5"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                            </Grid>

                            <!-- Entire ComboBox clickable -->
                            <ToggleButton Background="Transparent"
                                          BorderThickness="0"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          Opacity="0"/>

                            <!-- Dropdown popup -->
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">

                                <Border Background="#242A33"
                                        BorderBrush="#343B46"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        Margin="0,4,0,0"
                                        MinWidth="{Binding PlacementTarget.ActualWidth, RelativeSource={RelativeSource AncestorType=Popup}}">

                                    <ScrollViewer MaxHeight="260"
                                                  SnapsToDevicePixels="True">

                                        <ItemsPresenter
                                            KeyboardNavigation.DirectionalNavigation="Contained"/>

                                    </ScrollViewer>

                                </Border>

                            </Popup>

                        </Grid>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboBorder"
                                        Property="BorderBrush"
                                        Value="#FF9F43"/>
                            </Trigger>

                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboBorder"
                                        Property="BorderBrush"
                                        Value="#FF9F43"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>

    </Window.Resources>

    <Grid Margin="22">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">

            <TextBlock Text="TELEMETRY STUDIO"
                       FontSize="25"
                       FontWeight="Bold"
                       Foreground="#FF9F43"/>

            <TextBlock Text="Explore and compare vehicle telemetry data"
                       FontSize="13"
                       Foreground="#9299A5"
                       Margin="0,6,0,0"/>

        </StackPanel>

        <!-- Controls -->
        <Border Grid.Row="1"
                Background="#1A1E25"
                BorderBrush="#303641"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16"
                Margin="0,0,0,16">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1.3*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Session"
                           VerticalAlignment="Center"
                           Foreground="#9299A5"
                           Margin="0,0,10,0"/>

                <ComboBox x:Name="SessionComboBox"
                          Grid.Column="1"
                          Height="40"
                          Margin="0,0,18,0"
                          MinWidth="0"
                          DisplayMemberPath="Name"
                          SelectionChanged="SessionComboBox_SelectionChanged"/>

                <TextBlock Grid.Column="2"
                           Text="Display Mode"
                           VerticalAlignment="Center"
                           Foreground="#9299A5"
                           Margin="0,0,10,0"/>

                <ComboBox x:Name="DisplayModeComboBox"
                          Grid.Column="3"
                          Height="40"
                          Margin="0,0,18,0"
                          MinWidth="0"
                          SelectionChanged="DisplayModeComboBox_SelectionChanged"/>

                <TextBlock Grid.Column="4"
                           Text="Channel"
                           VerticalAlignment="Center"
                           Foreground="#9299A5"
                           Margin="0,0,10,0"/>

                <ComboBox x:Name="ChannelComboBox"
                          Grid.Column="5"
                          Height="40"
                          Margin="0,0,18,0"
                          MinWidth="0"
                          SelectionChanged="ChannelComboBox_SelectionChanged"/>

                <Button Grid.Column="6"
                        Content="Refresh"
                        Click="Refresh_Click"
                        Padding="20,8"
                        Background="#FF9F43"
                        Foreground="#111318"
                        FontWeight="SemiBold"
                        BorderThickness="0"
                        Cursor="Hand"/>

            </Grid>

        </Border>

        <!-- Single Channel View -->
        <Border x:Name="SingleChannelPanel"
                Grid.Row="2"
                Background="#1A1E25"
                BorderBrush="#303641"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="SingleChartTitle"
                           Grid.Row="0"
                           Text="Speed"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="#F0F2F5"
                           Margin="4,0,0,12"/>

                <ScottPlot:WpfPlot x:Name="SingleTelemetryPlot"
                                   Grid.Row="1"/>

                <Grid Grid.Row="2" Margin="0,12,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="MIN"
                                   Foreground="#9299A5"
                                   FontSize="10"/>

                        <TextBlock x:Name="SingleMinText"
                                   Text="--"
                                   FontSize="17"
                                   FontWeight="SemiBold"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="MAX"
                                   Foreground="#9299A5"
                                   FontSize="10"/>

                        <TextBlock x:Name="SingleMaxText"
                                   Text="--"
                                   FontSize="17"
                                   FontWeight="SemiBold"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="AVERAGE"
                                   Foreground="#9299A5"
                                   FontSize="10"/>

                        <TextBlock x:Name="SingleAverageText"
                                   Text="--"
                                   FontSize="17"
                                   FontWeight="SemiBold"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3">
                        <TextBlock Text="POINTS"
                                   Foreground="#9299A5"
                                   FontSize="10"/>

                        <TextBlock x:Name="SinglePointsText"
                                   Text="--"
                                   FontSize="17"
                                   FontWeight="SemiBold"/>
                    </StackPanel>

                </Grid>

            </Grid>

        </Border>

        <!-- Multi Channel View -->
        <ScrollViewer x:Name="MultiChannelPanel"
                      Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Visibility="Collapsed">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Speed -->
                <Border Grid.Row="0"
                        Grid.Column="0"
                        Background="#1A1E25"
                        BorderBrush="#303641"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12"
                        Margin="0,0,8,8">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="220"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="SPEED"
                                   Foreground="#FF9F43"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   Margin="4,0,0,8"/>

                        <ScottPlot:WpfPlot x:Name="SpeedPlot"
                                           Grid.Row="1"/>

                        <TextBlock x:Name="SpeedStatsText"
                                   Grid.Row="2"
                                   Text="Min: -- | Max: -- | Avg: --"
                                   Foreground="#9299A5"
                                   FontSize="11"
                                   Margin="4,8,0,0"/>

                    </Grid>

                </Border>

                <!-- RPM -->
                <Border Grid.Row="0"
                        Grid.Column="1"
                        Background="#1A1E25"
                        BorderBrush="#303641"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12"
                        Margin="8,0,0,8">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="220"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="ENGINE RPM"
                                   Foreground="#4DA3FF"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   Margin="4,0,0,8"/>

                        <ScottPlot:WpfPlot x:Name="RpmPlot"
                                           Grid.Row="1"/>

                        <TextBlock x:Name="RpmStatsText"
                                   Grid.Row="2"
                                   Text="Min: -- | Max: -- | Avg: --"
                                   Foreground="#9299A5"
                                   FontSize="11"
                                   Margin="4,8,0,0"/>

                    </Grid>

                </Border>

                <!-- Throttle -->
                <Border Grid.Row="1"
                        Grid.Column="0"
                        Background="#1A1E25"
                        BorderBrush="#303641"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12"
                        Margin="0,8,8,0">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="220"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="THROTTLE"
                                   Foreground="#42C98A"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   Margin="4,0,0,8"/>

                        <ScottPlot:WpfPlot x:Name="ThrottlePlot"
                                           Grid.Row="1"/>

                        <TextBlock x:Name="ThrottleStatsText"
                                   Grid.Row="2"
                                   Text="Min: -- | Max: -- | Avg: --"
                                   Foreground="#9299A5"
                                   FontSize="11"
                                   Margin="4,8,0,0"/>

                    </Grid>

                </Border>

                <!-- Brake -->
                <Border Grid.Row="1"
                        Grid.Column="1"
                        Background="#1A1E25"
                        BorderBrush="#303641"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12"
                        Margin="8,8,0,0">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="220"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="BRAKE"
                                   Foreground="#F06B6B"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   Margin="4,0,0,8"/>

                        <ScottPlot:WpfPlot x:Name="BrakePlot"
                                           Grid.Row="1"/>

                        <TextBlock x:Name="BrakeStatsText"
                                   Grid.Row="2"
                                   Text="Min: -- | Max: -- | Avg: --"
                                   Foreground="#9299A5"
                                   FontSize="11"
                                   Margin="4,8,0,0"/>

                    </Grid>

                </Border>

            </Grid>

        </ScrollViewer>

        <!-- Status -->
        <TextBlock x:Name="StatusText"
                   Grid.Row="3"
                   Text="Loading telemetry sessions..."
                   Foreground="#9299A5"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Margin="2,12,2,0"/>

    </Grid>

</Window>
